.gradle/*
# CRLF-stripped gradlew copies the build scripts create (self-deleting, but not on failure)
.gradlew.*
build/*
fuzz-results
tomcat-war/build
tomcat-valve/build
basquin-core/build
basquin-quarkus/runtime/build
